# OpsSaathi AI - Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS

APP_ENV="development"
# Database: PostgreSQL for Docker/prod, SQLite supported for zero-dependency local dev
DATABASE_URL="sqlite+aiosqlite:///./opssaathi.db"
# For Docker / production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/opssaathi"

JWT_SECRET="opssaathi-build-for-india-2026-super-secret-key-change-in-prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers: "gemini" | "mock"
LLM_PROVIDER="gemini"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Sarvam AI Voice Provider (optional, fallback to browser native Web Speech API)
SARVAM_API_KEY="YOUR_SARVAM_API_KEY"
VOICE_PROVIDER="browser"

# Paytm Payments Staging Integration
PAYTM_ENVIRONMENT="staging"
PAYTM_MID="YOUR_TEST_MID"
PAYTM_MERCHANT_KEY="YOUR_TEST_MERCHANT_KEY"
PAYTM_WEBSITE_NAME="WEBSTAGING"

# Frontend Origin for CORS
FRONTEND_ORIGIN="http://localhost:5173"
DEMO_DATA_MODE="true"
